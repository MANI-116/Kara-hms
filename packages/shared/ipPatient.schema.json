{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medicare-hms/ip.schema.json",
  "title": "IPRecord",
  "description": "Schema for JAMAL OP (Inpatient Record) entries",
  "type": "object",
  "properties": {
    "opId": {
      "type": "string",
      "description": "Reference to the patient OP ID (e.g., P202511066229)"
    },
    "patientId": {
      "type": "string",
      "description": "Same as opId, for compatibility"
    },
    "visitDate": {
      "type": "string",
      "format": "date",
      "description": "Date of visit in YYYY-MM-DD"
    },
    "visitTime": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
      "description": "Time of visit in HH:mm:ss"
    },
    "reasonForVisit": {
      "type": "string",
      "minLength": 3,
      "description": "Detailed reason for the visit"
    },
    "chiefComplaint": {
      "type": "string",
      "minLength": 3,
      "description": "Primary symptom or complaint"
    },
    "currentMedications": {
      "type": "string",
      "description": "Current medications patient is taking"
    },
    "vitalSigns": {
      "type": "object",
      "properties": {
        "weight": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 0 },
        "temperature": { "type": "number" },
        "bloodPressureSystolic": { "type": "integer" },
        "bloodPressureDiastolic": { "type": "integer" },
        "pulse": { "type": "integer" },
        "respiratoryRate": { "type": "integer" },
        "oxygenSaturation": { "type": "number" }
      },
      "required": [
        "weight",
        "temperature",
        "bloodPressureSystolic",
        "bloodPressureDiastolic",
        "pulse"
      ],
      "additionalProperties": false
    },
    "validUntil": {
      "type": "string",
      "format": "date-time",
      "description": "ISO timestamp for record validity"
    },
    "priority": {
      "type": "string",
      "enum": ["Low", "Medium", "High", "Emergency"],
      "default": "Medium"
    },
    "referredBy": {
      "type": "string",
      "description": "Referral doctor or hospital"
    },
    "department": {
      "type": "string",
      "minLength": 2,
      "description": "Department where consultation occurred"
    }
  },
  "required": [
    "opId",
    "visitDate",
    "visitTime",
    "reasonForVisit",
    "chiefComplaint",
    "vitalSigns",
    "department",
    "priority"
  ],
  "additionalProperties": false
}
