{
  "type": "object",
  "properties": {
    "fullName": { "type": "string", "minLength": 2 },
    "age": { "type": "integer", "minimum": 0, "maximum": 150 },
    "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
    "contact": { "type": "string", "minLength": 10,"maxLength":10,"pattern":"^[0-9]{10}$" },
    "address": { "type": "string", "nullable": true },
    "registrationDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "nullable": true },
    "bloodGroup": { "type": "string", "nullable": true },
    "assignDoctor":{"type":"string", "nullable":true},
    "weight":{ "type":"string", "nullable":true},
    "height":{ "type":"string", "nullable":true},
    "temperature":{ "type":"string", "nullable":true},
    "pulse":{ "type":"string", "nullable":true},
    "bloodPressureDiastolic":{ "type":"string", "nullable":true},
    "bloodPressureSystolic":{ "type":"string", "nullable":true},
    "respiratoryRate":{ "type":"string", "nullable":true},
    "oxygenSaturation":{ "type":"string", "nullable":true},
    "consultationFee":{"type":"number","nullable":false},
    "paymentMode":{"type":"string","nullable":false},
    "paymentStatus":{"type":"boolean","nullable":false},
    "totalAmount":{"type":"number","nullable":false}
  },
  "required": ["fullName", "age", "gender", "contact"],
  "additionalProperties": false
}